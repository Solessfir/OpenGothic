+	void DaedalusVm::invoke_function(DaedalusSymbol const* sym) {
+		if (sym == nullptr || sym->type() != DaedalusDataType::FUNCTION) {
+			throw DaedalusVmException {"invoke_function: not a function"};
+		}
+
+		std::function<void(DaedalusVm&)> callback;
+		if (sym->is_external()) {
+			if (auto it = _m_externals.find(const_cast<DaedalusSymbol*>(sym)); it != _m_externals.end()) {
+				callback = it->second;
+			} else if (_m_default_external.has_value()) {
+				callback = [this, sym](DaedalusVm& vm) {
+					(*_m_default_external)(vm, *const_cast<DaedalusSymbol*>(sym));
+				};
+			} else {
+				throw DaedalusVmException {"invoke_function: no external registered for " + sym->name()};
+			}
+		} else if (auto it = _m_function_overrides.find(sym->address()); it != _m_function_overrides.end()) {
+			// Match BL: typed overrides own their call frame; naked Ikarus
+			// overrides intentionally preserve parameters/results on the stack.
+			StackGuard guard {this, sym->rtype()};
+			it->second(*this);
+			guard.inhibit();
+			return;
+		} else {
+			unsafe_call(sym);
+			return;
+		}
+
+		push_call(sym);
+		try {
+			StackGuard guard {this, sym->rtype()};
+			callback(*this);
+			guard.inhibit();
+		} catch (...) {
+			pop_call();
+			throw;
+		}
+		pop_call();
+	}
+
 	std::shared_ptr<DaedalusInstance> DaedalusVm::unsafe_get_gi() {
 		return _m_instance;
 	}
