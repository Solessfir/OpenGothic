 		this->jump(address);
 	}
 
+	void DaedalusVm::invoke_function(DaedalusSymbol const* sym) {
+		if (sym == nullptr || sym->type() != DaedalusDataType::FUNCTION) {
+			throw DaedalusVmException {"invoke_function: not a function"};
+		}
+
+		std::function<void(DaedalusVm&)> callback;
+		if (sym->is_external()) {
+			if (auto it = _m_externals.find(const_cast<DaedalusSymbol*>(sym)); it != _m_externals.end()) {
+				callback = it->second;
+			} else if (_m_default_external.has_value()) {
+				callback = [this, sym](DaedalusVm& vm) {
+					(*_m_default_external)(vm, *const_cast<DaedalusSymbol*>(sym));
+				};
+			} else {
+				throw DaedalusVmException {"invoke_function: no external registered for " + sym->name()};
+			}
+		} else if (auto it = _m_function_overrides.find(sym->address()); it != _m_function_overrides.end()) {
+			callback = it->second;
+		} else {
+			unsafe_call(sym);
+			return;
+		}
+
+		push_call(sym);
+		try {
+			StackGuard guard {this, sym->rtype()};
+			callback(*this);
+			guard.inhibit();
+		} catch (...) {
+			pop_call();
+			throw;
+		}
+		pop_call();
+	}
+
 	std::shared_ptr<DaedalusInstance> DaedalusVm::unsafe_get_gi() {
 		return _m_instance;
 	}
@@ -699,6 +734,13 @@ namespace zenkit {
 			return std::get<int32_t>(v.value);
 		}
 
+		// The original engine pushes an instance as the index of its symbol, so a function with an int parameter
+		// that is called with an instance receives that index (LeGo's free() calls Bar_Delete(var int) this way).
+		if (std::holds_alternative<std::shared_ptr<DaedalusInstance>>(v.value)) {
+			auto const& inst = std::get<std::shared_ptr<DaedalusInstance>>(v.value);
+			return inst == nullptr ? 0 : static_cast<std::int32_t>(inst->symbol_index());
+		}
+
 		throw DaedalusVmException {"tried to pop_int but frame does not contain a int."};
 	}
 
