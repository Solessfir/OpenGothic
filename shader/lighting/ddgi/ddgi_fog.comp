#version 460
#extension GL_GOOGLE_include_directive          : enable
#extension GL_EXT_samplerless_texture_functions : enable

#include "scene.glsl"
#include "common.glsl"
#include "lighting/ddgi/ddgi_common.glsl"
#include "lighting/ddgi/ddgi_fog.glsl"

// How much the probes dim or tint the sky ambient of the haze near the camera, relative to open sky.
// Each texel holds the average along the view ray up to its slice, so the fog pass needs one lookup.
layout(local_size_x = 4, local_size_y = 2, local_size_z = 32) in;

shared vec3 factor[32][2][4];

DDGI_PUSH

layout(binding = 0, std140) uniform UboScene {
  SceneDesc scene;
  };
layout(binding = 1) uniform writeonly image3D result;
layout(binding = 2) uniform texture2D  irradiance;
layout(binding = 3) uniform sampler2D  ddgiIrradiance;
layout(binding = 4) uniform sampler2D  ddgiDistance;
layout(binding = 5, std430) readonly buffer Probes { DdgiProbe ddgiProbes[]; };

#include "lighting/ddgi/ddgi_sample.glsl"

vec3 skyIrradianceY(bool up) {
  return texelFetch(irradiance, ivec2(1, up ? 1 : 0), 0).rgb;
  }

vec3 project(mat4 m, vec3 pos) {
  vec4 p = m*vec4(pos,1);
  return p.xyz/p.w;
  }

void main() {
  const ivec3 size  = imageSize(result);
  const ivec3 at    = ivec3(gl_GlobalInvocationID);
  const uvec3 local = gl_LocalInvocationID;
  const bool  valid = all(lessThan(at, size));

  const vec2 inPos = ((vec2(at.xy)+0.5)/vec2(size.xy))*2.0-vec2(1.0);
  const vec3 pos0  = project(scene.viewProjectInv, vec3(inPos,0));
  const vec3 pos1  = project(scene.viewProjectInv, vec3(inPos,0.9999));
  const vec3 dir   = normalize(pos1-pos0);

  // the flat ambient that ddgi_apply falls back to, for up and down facing surfaces
  const vec3  openSky = 2.0*scene.ambient + (skyIrradianceY(true) + skyIrradianceY(false))*0.8;
  const float r0      = at.z>0 ? ddgiFogSliceDist(at.z-1, size.z) : 0.0;
  const float r1      = ddgiFogSliceDist(at.z, size.z);
  const vec3  P       = pos0 + dir*(0.5*(r0+r1)*100.0);

  vec3 f = vec3(1);
  if(valid) {
    float wu = 0, wd = 0;
    const vec3  up   = ddgiSampleIrradiance(P, vec3(0, 1,0), -dir, wu);
    const vec3  down = ddgiSampleIrradiance(P, vec3(0,-1,0), -dir, wd);
    const float w    = 0.5*(wu+wd);
    f = mix(vec3(1), min((up*wu + down*wd)/max(openSky*w, vec3(1e-6)), vec3(2)), w);
    }
  factor[local.z][local.y][local.x] = f*(r1-r0);
  barrier();

  // average along the ray up to this slice
  vec3 acc = vec3(0);
  for(uint i=0; i<=local.z; ++i)
    acc += factor[i][local.y][local.x];
  if(valid)
    imageStore(result, at, vec4(acc/r1, 1));
  }
