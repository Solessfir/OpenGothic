#version 460
#extension GL_GOOGLE_include_directive : enable

#include "scene.glsl"
#include "lighting/ddgi/ddgi_lights.glsl"

// Point lights that reach the probe grid, for the probe ray hits
layout(local_size_x = 64) in;

layout(push_constant, std430) uniform UboPush {
  vec3  gridMin;
  uint  numLights;
  vec3  gridMax;
  } push;

layout(binding = 0, std430) readonly buffer Lights { LightSource lights[]; };
layout(binding = 1, std430) buffer List { DdgiLightList list; };

void main() {
#if defined(CLEAR)
  list.count = 0;
#else
  const uint i = gl_GlobalInvocationID.x;
  if(i>=push.numLights)
    return;
  const LightSource l = lights[i];
  if(l.range<=0)
    return;
  const vec3 nearest = clamp(l.pos, push.gridMin, push.gridMax);
  const vec3 d       = nearest - l.pos;
  if(dot(d,d)>l.range*l.range)
    return;
  const uint at = atomicAdd(list.count, 1);
  if(at<DdgiMaxLights)
    list.id[at] = i;
#endif
  }
