#version 460
#extension GL_GOOGLE_include_directive : enable

#define LWC 1

#include "lighting/rt/rt_common.glsl"
#define CAPSULE_BINDING 12
#include "lighting/character_capsules.glsl"
#include "lighting/shadow_sampling.glsl"
#include "scene.glsl"
#include "common.glsl"

// Ray traced sun shadows: one ray per pixel towards the sun gives the visibility of the world and how far
// the blocker is, which sizes the penumbra for shadow_blur.comp. Characters are not in the ray tracing
// scene; their bone capsules add their shadows.
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant, std430) uniform Push {
  vec3 originLwc;
  } push;

layout(binding = 0, std140) uniform UboScene {
  SceneDesc scene;
  };
layout(binding = 1) uniform writeonly image2D result; // r: visibility, g: penumbra radius in pixels, b: linear depth in meters
layout(binding = 2) uniform usampler2D gbufNormal;
layout(binding = 3) uniform sampler2D  depth;
layout(binding = 4) uniform sampler2D  textureSm0;
layout(binding = 5) uniform sampler2D  textureSm1;

const float SunTan      = 0.01;     // same softness as shadow_mask.comp
const float MaxPenumbra = 40.0;     // cm
const float MaxRadius   = 24.0;     // pixels
const float MaxDistance = 5000*100; // cm

bool rayTest(vec3 pos, vec3 dir, float tMin, float tMax, out float rayT) {
  uint flags = RayFlagsShadow;
#if !defined(RAY_QUERY_AT)
  flags |= gl_RayFlagsOpaqueEXT;
#endif
  rayQueryEXT rayQuery;
  rayQueryInitializeEXT(rayQuery, topLevelAS, flags, CM_ShadowCaster, pos, tMin, dir, tMax);
  rayQueryProceedShadow(rayQuery);
  if(rayQueryGetIntersectionTypeEXT(rayQuery, true)==gl_RayQueryCommittedIntersectionNoneEXT)
    return false;
  rayT = rayQueryGetIntersectionTEXT(rayQuery, true);
  return true;
  }

// The shadow maps can rule out a blocker cheaply: where every texel around the pixel is lit, the ray would
// find nothing. Only lit with a margin, so edges, stepped low sun texels and acne still get their ray.
bool surelyLit(in sampler2D sm, vec3 shPos) {
  if(any(greaterThan(abs(shPos.xy), vec2(0.95))))
    return false;
  const vec2  texel = vec2(1)/vec2(textureSize(sm, 0));
  const float z     = max(shPos.z, 0.0);
  for(int y=-1; y<=1; y+=2)
    for(int x=-1; x<=1; x+=2) {
      const vec4 d = textureGather(sm, (shPos.xy + vec2(x,y)*texel*1.5)*0.5 + 0.5);
      if(any(greaterThan(d, vec4(z))))
        return false;
      }
  return true;
  }

void main() {
  const ivec2 at   = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size = imageSize(result);
  if(at.x>=size.x || at.y>=size.y)
    return;

  const float z = texelFetch(depth, at, 0).r;
  if(z>=1.0) {
    imageStore(result, at, vec4(1, 0, 1e4, 0));
    return;
    }

  const float linDepth = linearDepth(z, scene.clipInfo);
  const vec3  normal   = normalFetch(gbufNormal, at);
  if(scene.sunDir.y<=0.0 || dot(normal, scene.sunDir)<=0.0) {
    // facing away from the sun, the lighting gives no sun anyway
    imageStore(result, at, vec4(0, 0, linDepth*0.01, 0));
    return;
    }

  const vec2 ndc   = ((vec2(at)+0.5)*scene.screenResInv)*2.0 - vec2(1.0);
  const vec4 wpos4 = scene.viewProjectLwcInv*vec4(ndc, z, 1);
  const vec3 pos   = wpos4.xyz/wpos4.w;

  // the ray starts a little above the surface, scaled with distance as the depth gets coarser
  const float offset = 2.0 + linDepth*0.002;
  const vec3  shPos0 = shadowCascadePos(scene.viewShadowLwc[0], textureSm0, pos, normal);
  const vec3  shPos1 = shadowCascadePos(scene.viewShadowLwc[1], textureSm1, pos, normal);
  const bool  lit    = surelyLit(textureSm0, shPos0) || (any(greaterThan(abs(shPos0.xy), vec2(0.95))) && surelyLit(textureSm1, shPos1));
  float hitT = 0;
  const bool hit = !lit && rayTest(pos + push.originLwc + normal*offset, scene.sunDir, 1.0, MaxDistance, hitT);

  // characters within reach of the capsule list, the world ray already covers everything else
  const vec3  wpos      = pos + push.originLwc + normal*offset;
  float       blockerCm = -1;
  const bool  character = characterOccludes(wpos, wpos + scene.sunDir*3000.0, blockerCm);

  float distCm = hit ? hitT : -1.0;
  if(character)
    distCm = distCm>=0 ? min(distCm, blockerCm) : blockerCm;

  float radius = 0;
  if(distCm>=0) {
    const float penumbraCm = min(distCm*SunTan, MaxPenumbra);
    const float pixelCm    = linDepth*2.0/(scene.project[1][1]*float(size.y));
    radius = min(penumbraCm/pixelCm, MaxRadius);
    }

  const float vis = (hit || character) ? 0.0 : 1.0;
  imageStore(result, at, vec4(vis, radius, linDepth*0.01, 0));
  }
