<?xml version="1.0" encoding="utf-8"?>
<!-- Focused, as with a gamepad, it keeps its plain look under the focus ring: a ripple tints on focus and flashes grey when focus moves on -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/og_pill_fill" />
    <item>
        <ripple android:color="#26EEE8DE">
            <item android:drawable="@drawable/og_pill_fill" />
        </ripple>
    </item>
</selector>
