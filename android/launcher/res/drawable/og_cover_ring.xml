<?xml version="1.0" encoding="utf-8"?>
<!-- The selected game; orange while a gamepad focuses it, since focusing a cover selects it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <stroke android:width="2dp" android:color="@color/og_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="2dp" android:color="@color/og_text" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
