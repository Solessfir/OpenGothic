<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/og_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/og_ground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/og_rail"
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <include android:id="@+id/og_cover0" layout="@layout/og_cover" />

            <include
                android:id="@+id/og_cover1"
                layout="@layout/og_cover"
                android:layout_width="68dp"
                android:layout_height="98dp"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/og_cover2"
                layout="@layout/og_cover"
                android:layout_width="68dp"
                android:layout_height="98dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/og_line" />

        <FrameLayout
            android:id="@+id/og_main"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/og_hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="matrix" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/og_scrim_left" />

            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_gravity="bottom"
                android:background="@drawable/og_scrim_bottom" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/og_brand"
                    style="@style/Launcher.Text.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.14"
                    android:text="@string/og_brand"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    app:fontFamily="@font/og_plex_semibold" />

                <Button
                    android:id="@+id/og_update"
                    style="@style/Launcher.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:minHeight="44dp"
                    android:background="@drawable/og_pill"
                    android:drawableStart="@drawable/og_dot"
                    android:drawablePadding="10dp"
                    android:paddingStart="16dp"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/og_account"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/og_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp">

                        <TextView
                            android:id="@+id/og_account_initial"
                            style="@style/Launcher.Text"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/og_avatar"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textSize="13sp"
                            app:fontFamily="@font/og_plex_semibold" />

                        <ImageView
                            android:id="@+id/og_account_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/og_avatar"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/og_account_name"
                        style="@style/Launcher.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/og_sign_in"
                    style="@style/Launcher.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:background="@drawable/og_pill"
                    android:text="@string/og_sign_in_steam"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/og_panel"
                android:layout_width="460dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="40dp"
                android:layout_marginBottom="30dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/og_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="300dp"
                    android:maxHeight="116dp"
                    android:scaleType="fitStart" />

                <TextView
                    android:id="@+id/og_title"
                    style="@style/Launcher.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/og_status"
                    style="@style/Launcher.Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.15" />

                <ProgressBar
                    android:id="@+id/og_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/og_progress" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/og_primary"
                        style="@style/Launcher.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp" />

                    <Button
                        android:id="@+id/og_secondary"
                        style="@style/Launcher.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp" />

                    <Button
                        android:id="@+id/og_plain"
                        style="@style/Launcher.Button.Plain"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp" />

                    <ImageButton
                        android:id="@+id/og_more"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/og_button_secondary"
                        android:contentDescription="@string/og_more"
                        android:src="@drawable/og_ic_more" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/og_sheet_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/og_dialog_dim"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="341dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:clickable="true"
            android:focusable="false"
            android:orientation="horizontal">

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/og_border_soft" />

            <LinearLayout
                android:id="@+id/og_sheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/og_sheet"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/og_sheet_title"
                            style="@style/Launcher.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:textSize="18sp"
                            app:fontFamily="@font/og_plex_semibold" />

                        <TextView
                            style="@style/Launcher.Text.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/og_language_hint"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/og_sheet_close"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="-8dp"
                        android:background="@drawable/og_button_plain"
                        android:contentDescription="@string/og_close"
                        android:src="@drawable/og_ic_close" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1">

                    <RadioGroup
                        android:id="@+id/og_languages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:id="@+id/og_sheet_size"
                    style="@style/Launcher.Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/og_sheet_download"
                    style="@style/Launcher.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:text="@string/og_download"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
