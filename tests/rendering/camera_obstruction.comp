#version 450
#extension GL_GOOGLE_include_directive : enable
#include "scene.glsl"

SceneDesc scene;
#include "materials/camera_obstruction.glsl"

layout(local_size_x=1) in;
layout(binding=0,std430) buffer Output { vec4 values[]; };

void main() {
  uint id=gl_GlobalInvocationID.x;
  scene.screenResInv=vec2(1);
  scene.projectInv=mat4(1);
  scene.view=mat4(1);
  scene.cameraFadeNear2=45.0*45.0;
  scene.cameraFadeFar2=180.0*180.0;
  scene.cameraFadeTarget=vec4(0);
  values[id].xy=vec2(cameraObstructionVisibility(vec2(0.5),float(id)),
                     cameraObstructionThreshold(ivec2(id&3u,(id>>2u)&3u)));

  const vec3 samples[16]=vec3[16](
    vec3(0,0,200), vec3(0,0,350), vec3(0,0,500),
    vec3(80,0,350), vec3(180,0,350), vec3(135,0,350),
    vec3(0,0,570), vec3(0,0,600), vec3(0,0,650),
    vec3(0,0,-350), vec3(0,0,350), vec3(0,0,350),
    vec3(0,-70,350), vec3(0,-37.5,350), vec3(0,-15,350), vec3(0,0,20));
  uint sampleId=id%16u;
  scene.cameraFadeTarget=vec4(0,0,600,180);
  if(sampleId==10u) scene.cameraFadeTarget.xyz=vec3(0);
  if(sampleId==11u) scene.cameraFadeFar2=0;
  vec3 p=samples[sampleId];
  values[id].z=cameraObstructionVisibilityAt(p);

  // An oblique camera-to-player direction must give identical coverage.
  mat3 rotation=mat3(vec3(0.8,0,-0.6),vec3(0,1,0),vec3(0.6,0,0.8));
  rotation=mat3(vec3(1,0,0),vec3(0,0.8,0.6),vec3(0,-0.6,0.8))*rotation;
  scene.view=mat4(rotation);
  scene.cameraFadeTarget.xyz=rotation*scene.cameraFadeTarget.xyz;
  values[id].w=cameraObstructionVisibilityAt(rotation*p);
  }
